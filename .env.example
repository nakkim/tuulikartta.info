# Used by `npx prisma migrate dev` (and `prisma studio`) when run from the
# host machine, against the postgres container's published port (see
# docker-compose.yml). Also used as the default DATABASE_URL by
# php/dataMiner.php when running PHP locally (outside docker-compose)
# against the same container.
#
# Copy this file to .env and adjust if needed.
DATABASE_URL="postgresql://tuulikartta:tuulikartta@localhost:5434/tuulikartta"
