# Copy this file to .env and set real values. .env is gitignored.
#
# docker compose reads this file automatically: POSTGRES_* configure the
# postgres container, and the app container's DATABASE_URL is built from
# them (see docker-compose.yml).
POSTGRES_USER=tuulikartta
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tuulikartta

# Used by `npx prisma migrate dev` (and `prisma studio`) when run from the
# host machine, against the postgres container's published port (see
# docker-compose.yml). Also export it when running php/dataMiner.php locally
# (outside docker-compose) against the same container.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5434/${POSTGRES_DB}"
